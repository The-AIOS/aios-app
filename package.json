{
  "name": "aios-app",
  "productName": "AIOS",
  "version": "0.8.7",
  "desktopName": "aios.desktop",
  "description": "AIOS App — the one-for-all AIOS desktop application. Glass, not engine.",
  "license": "GPL-2.0-or-later",
  "main": "out/main/main.js",
  "scripts": {
    "gen-i18n": "node scripts/gen-i18n.mjs",
    "compile": "npm run gen-i18n && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "start": "npm run compile && electron .",
    "rebuild": "electron-rebuild -f -w node-pty",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "smoke": "npm run compile && electron . --smoke",
    "sync-core": "node scripts/sync-core.mjs",
    "check:tokens": "node scripts/check-forbidden-tokens.mjs",
    "dist": "npm run compile && electron-builder --mac dmg --publish never && npm run verify:package",
    "dist:linux": "npm run compile && electron-builder --linux --publish never && npm run verify:package",
    "dist:win": "npm run compile && electron-builder --win --config.npmRebuild=false --publish never && npm run verify:package",
    "verify:package": "node scripts/verify-package.mjs",
    "start:isolated": "npm run compile && electron . --user-data-dir=.dev-userdata"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/node": "^25.9.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.11.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "marked": "^18.0.5",
    "node-pty": "^1.1.0"
  },
  "build": {
    "appId": "com.the-aios.app",
    "productName": "AIOS",
    "publish": [
      {
        "provider": "github",
        "owner": "The-AIOS",
        "repo": "aios-app"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "renderer/**/*",
      "package.json",
      "scripts/setup/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "CFBundleDisplayName": "AIOS"
      },
      "identity": "Pulsar Labs (DY7C5S7Z56)",
      "artifactName": "AIOS-${arch}.${ext}"
    },
    "dmg": {
      "title": "AIOS"
    },
    "linux": {
      "category": "Development",
      "icon": "build/icon.png",
      "synopsis": "The one-for-all AIOS interface — Glass, not engine.",
      "maintainer": "The AIOS <noreply@the-aios.com>",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "StartupWMClass": "aios"
        }
      },
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AIOS-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AIOS-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "AIOS-${arch}.${ext}"
    },
    "copyright": "Copyright © 2026 The-AIOS"
  },
  "author": "The AIOS",
  "homepage": "https://www.the-aios.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-AIOS/aios-app.git"
  },
  "bugs": {
    "url": "https://github.com/The-AIOS/aios-app/issues"
  },
  "keywords": [
    "aios",
    "claude",
    "claude-code",
    "agents",
    "desktop",
    "electron",
    "terminal",
    "obsidian",
    "second-brain"
  ]
}
